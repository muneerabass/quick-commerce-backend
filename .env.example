HTTP_PORT=:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickcommerce?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-separate-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m
OTP_RESEND_AFTER=60s
OTP_MAX_ATTEMPTS=5

# Local dev: enables [DEV OTP] stdout logging and GET /api/v1/auth/dev/last-otp.
# Must be false in production.
DEV_OTP_LOG=true

# Phone to be upgraded to admin on first OTP verify.
ADMIN_PHONE=+919999999999

# Optional: real OTP delivery (leave empty in dev when DEV_OTP_LOG=true).
TWO_FACTOR_API_KEY=
TWO_FACTOR_TEMPLATE=OTP1
TWO_FACTOR_BASE_URL=https://2factor.in

# Optional: geocoding for user addresses.
GOOGLE_MAPS_PLATFORM_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com

# Cloudinary signed uploads (admin only). All three required to enable the
# POST /api/v1/admin/uploads/signature endpoint. Leave empty to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
